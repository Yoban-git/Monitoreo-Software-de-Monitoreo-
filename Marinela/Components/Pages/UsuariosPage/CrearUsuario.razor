@page "/Crear-usuario"
@using Marinela.Models.Roles
@using Marinela.Models.Usuarios
@using Marinela.ViewModels.RolController
@using Marinela.ViewModels.UsuarioController
@inject UsuarioService UsuarioService
@inject RolService RolService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<h3>Crear Usuario</h3>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(exito ? "alert-success" : "alert-danger")">
        @mensaje
    </div>
}

<EditForm Model="nuevoUsuario" OnValidSubmit="GuardarUsuario">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="nombre">Nombre</label>
        <InputText id="nombre" class="form-control" @bind-Value="nuevoUsuario.Nombre" />
    </div>

    <div class="mb-3">
        <label for="username">Usuario</label>
        <InputText id="username" class="form-control" @bind-Value="nuevoUsuario.UserName" />
    </div>

    <div class="mb-3">
        <label for="email">Correo</label>
        <InputText id="email" class="form-control" @bind-Value="nuevoUsuario.Email" />
    </div>

    <div class="mb-3">
        <label for="password">Contraseña</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="nuevoUsuario.Password" />
    </div>

    <div class="mb-3">
        <label for="rol">Rol</label>
        <InputSelect id="rol" class="form-control" @bind-Value="nuevoUsuario.IdRol">
            <option value="">-- Selecciona un rol --</option>
            @foreach (var rol in roles)
            {
                <option value="@rol.IdRol">@rol.NombreRol</option>
            }
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-success" disabled=@guardar>@(guardar ? "Guardando..." : "Guardar")</button>
    <button type="button" class="btn btn-secondary" @onclick="Volver">Cancelar</button>
</EditForm>

@code {
    private Usuario nuevoUsuario = new Usuario();
    private List<Rol> roles = new(); // lista de roles
    private string mensaje = string.Empty;
    private bool exito = false;
    private bool guardar = false; // bandera para estado de guardado

    protected override async Task OnInitializedAsync()
    {
        try
        {
            roles = await RolService.ObtenerTodosRolesAsync(); // cargar roles desde la BD
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar datos: {ex.Message}";
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
            roles = new List<Rol>();
        }
    }

    private async Task GuardarUsuario()
    {
        guardar = true; // activar estado de guardado
        try
        {
            var resultado = await UsuarioService.CrearUsuarioAsync(nuevoUsuario);

            if (resultado.Exito)
            {
                exito = true;
                mensaje = "Usuario creado exitosamente.";
                Snackbar.Add("Usuario creado correctamente", Severity.Success);
                NavigationManager.NavigateTo("/usuarios-list");
            }
            else
            {
                guardar = false; // resetear estado de guardado
                exito = false;
                mensaje = resultado.Error ?? "Error desconocido al crear usuario.";
                Snackbar.Add($"Error: {resultado.Error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            guardar = false; // resetear estado de guardado
            exito = false;
            mensaje = $"Error inesperado: {ex.Message}";
            Snackbar.Add($"Error inesperado:{ex.Message}", Severity.Error);
        }
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/usuarios-list");
    }
}
