@page "/cambiar-password/{idUsuario:guid}"
@using Marinela.Models.Usuarios
@using Marinela.ViewModels.UsuarioController
@inject UsuarioService UsuarioService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<h3>Cambiar Contraseña</h3>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(exito ? "alert-success" : "alert-danger")">
        @mensaje
    </div>
}

<EditForm Model="modelo" OnValidSubmit="CambiarPassword">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Usuario: @usuario?.UserName</label>
    </div>

    <div class="mb-3">
        <label for="password">Nueva Contraseña</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="modelo.NuevaPassword" />
    </div>

    <button type="submit" class="btn btn-primary">Cambiar</button>
    <button type="button" class="btn btn-secondary" @onclick="Volver">Cancelar</button>
</EditForm>

@code {
    [Parameter] public Guid idUsuario { get; set; }
    private Usuario? usuario;
    private CambiarPasswordViewModel modelo = new();
    private string mensaje = string.Empty;
    private bool exito = false;
    protected override async Task OnInitializedAsync()
    {
        usuario = await UsuarioService.ObtenerUsuarioPorGuid(idUsuario);
    }

    private async Task CambiarPassword()
    {
        try
        {
            var resultado = await UsuarioService.CambiarContraseniaAsync(idUsuario, modelo.NuevaPassword);
            if (resultado.Exito)
            {
                exito = true;
                mensaje = "Contraseña actualizada exitosamente.";
                Snackbar.Add($"Contraseña actualizada correctamente",Severity.Success);
                NavigationManager.NavigateTo("/usuarios-list");
            }
            else
            {
                exito = false;
                mensaje = resultado.Error ?? "Error desconocido al actualizar usuario.";
                Snackbar.Add($"Error al cambiar contraseña: {resultado.Error}",Severity.Error);
            }
        }
        catch(Exception ex)
        {
            exito = false;
            Snackbar.Add($"Error inesperado: {ex.Message}",Severity.Error);
        }

    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/usuarios-list");
    }

    public class CambiarPasswordViewModel
    {
        public string NuevaPassword { get; set; } = string.Empty;
    }
}
