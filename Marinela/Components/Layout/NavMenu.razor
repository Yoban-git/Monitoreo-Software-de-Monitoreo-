@using Marinela.ViewModels.Login
@using Microsoft.AspNetCore.Components.Routing
@inject AuthService _AuthService
@inject NavigationManager NavigationManager

<aside class="sidebar @(sidebarOpen ? "expanded" : "")">

    <!-- Logo -->
    <div class="sidebar-logo" @onclick="ToggleSidebar">
        <div class="logo-icon">M</div>
        <span class="logo-text">Marinela</span>
    </div>

    <!-- ══════════════════════════════════════
         PARTE 1: Navegación — crece libremente
         ══════════════════════════════════════ -->
    <div class="sidebar-body">
        <nav class="sidebar-nav">

            <!-- Home -->
            <NavLink class="nav-item" href="" Match="NavLinkMatch.All" ActiveClass="active">
                <span class="nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                </span>
                <span class="nav-label">Home</span>
            </NavLink>

            <!-- ── Gestión Usuarios (submenu) ── -->
            @if (_AuthService.TienePermiso("Gestionar_Cuentas"))
            {
                <div class="nav-item submenu-header @(submenuGestionOpen ? "is-open" : "")"
                    @onclick="ToggleSubmenuGestion">
                    <span class="nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </span>
                    <span class="nav-label">
                        Gestión Usuarios
                        <span class="arrow">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"/>
                            </svg>
                        </span>
                    </span>
                </div>

                <div class="submenu @(submenuGestionOpen && sidebarOpen ? "submenu-open" : "")">
                        <NavLink class="nav-item sub-item" href="usuarios-list" ActiveClass="active">
                            <span class="nav-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
                                    <line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/>
                                    <line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
                                </svg>
                            </span>
                            <span class="nav-label">Lista Usuarios</span>
                        </NavLink>

                        <NavLink class="nav-item sub-item" href="Lista_Roles" ActiveClass="active">
                            <span class="nav-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="8" r="6"/>
                                    <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/>
                                </svg>
                            </span>
                            <span class="nav-label">Lista Roles</span>
                        </NavLink>

                        <NavLink class="nav-item sub-item" href="Lista_Permisos" ActiveClass="active">
                            <span class="nav-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                </svg>
                            </span>
                            <span class="nav-label">Lista Permisos</span>
                        </NavLink>
                </div>
            }

            <!-- ── Gestión Sensores (submenu) ── -->
            @if (_AuthService.TienePermiso("Gestionar_Sensores"))
            {
                <div class="nav-item submenu-header @(submenuSensoresOpen ? "is-open" : "")"
                    @onclick="ToggleSubmenuSensores">
                    <span class="nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <ellipse cx="12" cy="5" rx="9" ry="3"/>
                            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
                        </svg>
                    </span>
                    <span class="nav-label">
                        Gestión Sensores
                        <span class="arrow">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"/>
                            </svg>
                        </span>
                    </span>
                </div>


                <div class="submenu @(submenuSensoresOpen && sidebarOpen ? "submenu-open" : "")">
                        <NavLink class="nav-item sub-item" href="sensores-list" ActiveClass="active">
                            <span class="nav-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
                                    <line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/>
                                    <line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
                                </svg>
                            </span>
                            <span class="nav-label">Lista Sensores</span>
                        </NavLink>
                </div>
            }

            <!-- CARD Sensores -->
            @if(_AuthService.TienePermiso("Monitorear_Sensores"))
            {
                <NavLink class="nav-item" href="Ver-sensores" ActiveClass="active">
                    <span class="nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="3" width="20" height="14" rx="2"/>
                            <line x1="8" y1="21" x2="16" y2="21"/>
                            <line x1="12" y1="17" x2="12" y2="21"/>
                        </svg>
                    </span>
                    <span class="nav-label">CARD Sensores</span>
                </NavLink>
            }

            <!-- Cargar Excel -->
            @if (_AuthService.TienePermiso("Cargar_Excel"))
            {
                <NavLink class="nav-item" href="cargar-excel" ActiveClass="active">
                    <span class="nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                            <line x1="16" y1="13" x2="8" y2="13"/>
                            <line x1="16" y1="17" x2="8" y2="17"/>
                            <polyline points="10 9 9 9 8 9"/>
                        </svg>
                    </span>
                    <span class="nav-label">Cargar Excel</span>
                </NavLink>
            }

        </nav>
    </div>

    <!-- ══════════════════════════════════════
         PARTE 2: Usuario — siempre al fondo
         ══════════════════════════════════════ -->
    <div class="sidebar-footer">
        @if (_AuthService.IsLoggedIn)
        {
            <div class="user-card">
                <div class="avatar">@(_AuthService.CurrentUser?.Substring(0, 1).ToUpper())</div>
                <div class="user-info">
                    <div class="user-name">@_AuthService.CurrentUser</div>
                    <div class="user-role">@_AuthService.CurrentUserRol--(@_AuthService.CurrenRolName)</div>
                </div>
            </div>
            <button class="btn-logout" @onclick="Logout" title="Cerrar sesión">
                <span class="nav-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                </span>
                <span class="nav-label">Cerrar Sesión</span>
            </button>
        }
    </div>

</aside>

@code {
    private bool sidebarOpen = false;
    private bool submenuGestionOpen = false;
    private bool submenuSensoresOpen = false;

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
        if (!sidebarOpen)
        {
            submenuGestionOpen = false;
            submenuSensoresOpen = false;
        }
    }

    private void ToggleSubmenuGestion()
    {
        if (!sidebarOpen) { sidebarOpen = true; submenuGestionOpen = true; }
        else submenuGestionOpen = !submenuGestionOpen;
    }

    private void ToggleSubmenuSensores()
    {
        if (!sidebarOpen) { sidebarOpen = true; submenuSensoresOpen = true; }
        else submenuSensoresOpen = !submenuSensoresOpen;
    }

    private void Logout()
    {
        _AuthService.Logout();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}

<style>
:root {
    --sb-collapsed: 64px;
    --sb-expanded: 240px;
    --accent: #0d6efd;
    --text-main: #1a1a2e;
    --text-muted: #777;
    --border: #e8eaed;
    --hover-bg: #f0f4ff;
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
}

/* ══════════════════════════
   SIDEBAR — contenedor fijo
   NO hace scroll él mismo,
   delega el scroll al body
   ══════════════════════════ */
.sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: var(--sb-collapsed);
    background: #fff;
    border-right: 1px solid var(--border);
    box-shadow: 2px 0 16px rgba(0,0,0,0.07);
    display: flex;
    flex-direction: column;
    z-index: 1000;
    overflow: hidden;
    transition: width 0.3s var(--ease);
    font-family: 'DM Sans', 'Segoe UI', sans-serif;
}

.sidebar.expanded { width: var(--sb-expanded); }

/* ══════════════════════════
   LOGO — fijo arriba
   ══════════════════════════ */
.sidebar-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 14px;
    height: 64px;
    min-height: 64px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    flex-shrink: 0;
    user-select: none;
    background: #fff;
}

.logo-icon {
    width: 36px;
    height: 36px;
    min-width: 36px;
    background: var(--accent);
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 700;
    font-size: 17px;
}

.logo-text {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-main);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.22s ease 0.05s, transform 0.22s ease 0.05s;
}

.sidebar.expanded .logo-text { opacity: 1; transform: translateX(0); }

/* ══════════════════════════
   TOGGLE
   ══════════════════════════ */
.toggle-btn {
    position: absolute;
    top: 20px;
    right: -13px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    background: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1100;
    color: #555;
    transition: background 0.18s, color 0.18s, transform 0.3s var(--ease);
    padding: 0;
}

.toggle-btn:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
.sidebar.expanded .toggle-btn { transform: rotate(180deg); }

/* ══════════════════════════════════════════════════
   PARTE 1 — SIDEBAR-BODY
   flex: 1        → ocupa TODO el espacio disponible
   min-height: 0  → permite que el scroll funcione
   overflow-y: auto → scroll solo si el contenido
                      no cabe en pantalla
   ══════════════════════════════════════════════════ */
.sidebar-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
}

.sidebar-body::-webkit-scrollbar { width: 3px; }
.sidebar-body::-webkit-scrollbar-thumb { background: #d0d5dd; border-radius: 3px; }
.sidebar-body::-webkit-scrollbar-track { background: transparent; }

.sidebar-nav {
    padding: 10px 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

/* ══════════════════════════
   NAV ITEMS
   ══════════════════════════ */
.nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 8px;
    height: 42px;
    border-radius: 10px;
    cursor: pointer;
    color: #555;
    text-decoration: none !important;
    transition: background 0.16s, color 0.16s;
    white-space: nowrap;
    flex-shrink: 0;
    border: none;
    background: transparent;
    width: 100%;
}

.nav-item:hover { background: var(--hover-bg); color: var(--accent); }
.nav-item.active { background: var(--accent); color: #fff; }

.nav-icon {
    width: 36px;
    min-width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.nav-label {
    font-size: 13.5px;
    font-weight: 500;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.2s ease 0.06s, transform 0.2s ease 0.06s;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
}

.sidebar.expanded .nav-label { opacity: 1; transform: translateX(0); }

/* ══════════════════════════
   SUBMENÚS
   ══════════════════════════ */
.submenu-header { user-select: none; }
.submenu-header.is-open { color: var(--accent); background: var(--hover-bg); }

.arrow {
    display: flex;
    align-items: center;
    transition: transform 0.22s ease;
    flex-shrink: 0;
}

.submenu-header.is-open .arrow { transform: rotate(180deg); }

.submenu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.28s ease;
}

.submenu.submenu-open { max-height: 300px; }

.nav-item.sub-item { height: 38px; padding-left: 14px; border-radius: 8px; }
.nav-item.sub-item .nav-icon { width: 28px; min-width: 28px; height: 28px; }
.nav-item.sub-item .nav-label { font-size: 13px; }

/* ══════════════════════════════════════════════════
   PARTE 2 — SIDEBAR-FOOTER
   flex-shrink: 0  → NUNCA se comprime
   Siempre queda pegado al fondo del sidebar
   ══════════════════════════════════════════════════ */
.sidebar-footer {
    padding: 10px 8px;
    border-top: 1px solid var(--border);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: #fff;
}

.user-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 8px;
    border-radius: 10px;
    overflow: hidden;
}

.avatar {
    width: 36px;
    min-width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    flex-shrink: 0;
}

.user-info {
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.2s ease 0.06s, transform 0.2s ease 0.06s;
    overflow: hidden;
}

.sidebar.expanded .user-info { opacity: 1; transform: translateX(0); }

.user-name { font-size: 13px; font-weight: 700; color: var(--text-main); white-space: nowrap; }
.user-role { font-size: 11px; color: var(--text-muted); white-space: nowrap; }

.btn-logout {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 8px;
    height: 40px;
    border-radius: 10px;
    border: none;
    background: transparent;
    color: #e74c3c;
    cursor: pointer;
    width: 100%;
    transition: background 0.16s;
    flex-shrink: 0;
}

.btn-logout:hover { background: #fff0ef; }
.btn-logout .nav-icon { min-width: 36px; }
</style>